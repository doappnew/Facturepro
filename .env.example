# Exemple sans secret. Les vraies valeurs se saisissent UNIQUEMENT dans l'hébergeur (Render), jamais dans GitHub ni dans un chat.
NODE_VERSION=22
PI_NETWORK=testnet            # testnet | mainnet
SUPABASE_URL=https://mvysfsbrpdhngebrpubx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # secret, côté serveur seulement
PI_API_KEY=                   # secret, une clé par application Pi
PI_VALIDATION_KEY=            # contenu de /validation-key.txt
SESSION_SECRET=             # secret aléatoire d'au moins 32 caractères (sessions)
PUBLIC_BASE_URL=              # ex. https://facturepro-testnet.onrender.com
# --- Tests Testnet exigés par la core team (à retirer avant le Mainnet) ---
TESTNET_PAYOUT=0              # 1 pour activer le bouton d'envoi (A2U) ; 0 par défaut
TESTNET_RECEIVE=0             # 1 pour activer le bouton de réception (U2A) ; 0 par défaut
PI_WALLET_SEED=               # clé secrète du portefeuille de l'app (S...) : à saisir dans Render seulement, à SUPPRIMER après les tests
